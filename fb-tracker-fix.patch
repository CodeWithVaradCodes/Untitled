+def messenger_list_js(reset=False):
+    """Reports the conversation list, its scroll position and where to wheel it."""
+    return rf"""
+(() => {{
+  const reset = {str(bool(reset)).lower()};
+  const links = Array.from(document.querySelectorAll('a[href*="/messages/t/"], a[href*="/t/"]'))
+    .filter(a => {{
+      const r = a.getBoundingClientRect();
+      return r.width > 120 && r.height > 20;
+    }});
+  if (!links.length) {{
+    return {{ok: false, reason: 'no conversation links on this page', entries: []}};
+  }}
+
+  let scroller = null;
+  for (const a of links) {{
+    let el = a.parentElement;
+    for (let i = 0; i < 15 && el; i++) {{
+      const style = getComputedStyle(el);
+      if (/(auto|scroll)/.test(style.overflowY) && el.scrollHeight > el.clientHeight + 40) {{
+        scroller = el;
+        break;
+      }}
+      el = el.parentElement;
+    }}
+    if (scroller) break;
+  }}
+
+  if (reset && scroller) scroller.scrollTop = 0;
+
+  const entries = [];
+  const seen = new Set();
+  for (const a of links) {{
+    const href = a.getAttribute('href') || '';
+    if (!href || seen.has(href)) continue;
+    seen.add(href);
+    const raw = (a.innerText || '').trim();
+    if (!raw) continue;
+    entries.push({{
+      href: href,
+      name: raw.split('\n')[0].trim().slice(0, 90),
+      text: raw.replace(/\s+/g, ' ').slice(0, 200)
+    }});
+  }}
+
+  const box = scroller || links[0];
+  const r = box.getBoundingClientRect();
+  return {{
+    ok: true,
+    entries: entries,
+    x: Math.round(r.left + r.width / 2),
+    y: Math.round(r.top + Math.min(r.height / 2, 240)),
+    height: Math.round(r.height),
+    scrollTop: scroller ? Math.round(scroller.scrollTop) : 0,
+    scrollHeight: scroller ? Math.round(scroller.scrollHeight) : 0
+  }};
+}})()
+"""
