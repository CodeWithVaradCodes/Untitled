+def resolve_ws_url(tab, port=9222):
+    """
+    Re-reads the target list so a stale webSocketDebuggerUrl (tab reloaded,
+    Chrome restarted) does not wedge the run.
+    """
+    tabs, _ = fetch_targets(port)
+    target_id = tab.get("id")
+    for candidate in tabs:
+        if target_id and candidate.get("id") == target_id:
+            return candidate.get("webSocketDebuggerUrl") or tab.get("webSocketDebuggerUrl")
+    return tab.get("webSocketDebuggerUrl")
+
+
+async def connect_tab(tab, name, log=None, port=9222):
+    """Connects to a tab, retrying once with a freshly resolved socket URL."""
+    ws_url = tab.get("webSocketDebuggerUrl")
+    if not ws_url:
+        raise CDPError(
+            f"The {name} tab has no DevTools socket URL. Press Refresh Tabs."
+        )
+    client = CDPClient(ws_url, name=name)
+    try:
+        await client.connect()
+        return client
+    except CDPError as first_error:
+        if log:
+            log(f"{name} tab: {first_error} Retrying with a fresh target list...", "warning")
+        await client.close()
+        fresh = resolve_ws_url(tab, port=port)
+        if not fresh or fresh == ws_url:
+            raise
+        client = CDPClient(fresh, name=name)
+        await client.connect()
+        return client
