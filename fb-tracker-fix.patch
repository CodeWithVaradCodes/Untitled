+def describe_key(ch):
+    """Returns (key, code, virtual_key_code, modifiers) for a character."""
+    if ch in _PUNCTUATION:
+        code, vk = _PUNCTUATION[ch]
+        modifiers = 8 if ch in _SHIFTED else 0
+        return ch, code, vk, modifiers
+    if ch.isdigit():
+        return ch, f"Digit{ch}", ord(ch), 0
+    lower = ch.lower()
+    if lower.isalpha():
+        return ch, f"Key{lower.upper()}", ord(lower.upper()), 8 if ch.isupper() else 0
+    return ch, "Unidentified", 0, 0
+
