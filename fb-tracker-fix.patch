+def search_results_js(query):
+    return f"""
+(() => {{
+  const q = {json.dumps(query)}.toLowerCase();
+  const visible = el => {{
+    const r = el.getBoundingClientRect();
+    return r.width > 40 && r.height > 10;
+  }};
+  const nodes = document.querySelectorAll(
+    '[role="listbox"] [role="option"], [role="grid"] [role="row"], a[href*="/messages/t/"], a[href*="/t/"]'
+  );
+  const out = [];
+  for (const el of nodes) {{
+    if (!visible(el)) continue;
+    const text = (el.innerText || '').trim();
+    if (!text || text.length > 200) continue;
+    if (/^(search|search messenger|messages|new message|see all|people|conversations)$/i.test(text)) continue;
+    const r = el.getBoundingClientRect();
+    out.push({{text: text.replace(/\\s+/g, ' ').slice(0, 160), x: r.left + r.width / 2, y: r.top + r.height / 2}});
+    if (out.length >= 12) break;
+  }}
+  return out;
+}})()
+"""
