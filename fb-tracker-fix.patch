+THREAD_JS = r"""
+(() => {
+  const main = document.querySelector('div[role="main"]');
+  if (!main) return {ok: false, title: '', messages: [], empty: false};
+
+  let title = '';
+  const heading = main.querySelector('h1, h2, [role="heading"]');
+  if (heading) title = (heading.innerText || '').trim().split('\n')[0];
+  if (!title) {
+    const link = main.querySelector('a[href*="/messages/t/"], a[href*="/t/"]');
+    if (link) title = (link.innerText || '').trim().split('\n')[0];
+  }
+
+  const mainRect = main.getBoundingClientRect();
+  const rows = Array.from(main.querySelectorAll('[role="row"], [role="listitem"]'));
+  const messages = [];
+  let lastKey = null;
+  for (const row of rows) {
+    const bubble = row.querySelector('div[dir="auto"]') || row.querySelector('span[dir="auto"]');
+    if (!bubble) continue;
+    const text = (bubble.innerText || '').trim();
+    if (!text || text.length > 2000) continue;
+    if (/^(seen|delivered|sent|sending|failed to send|\d{1,2}:\d{2}\s?(am|pm)?)$/i.test(text)) continue;
+
+    const labels = [row.getAttribute('aria-label') || ''];
+    for (const el of row.querySelectorAll('[aria-label]')) labels.push(el.getAttribute('aria-label') || '');
+    const joined = labels.join(' ').toLowerCase();
+    const saidYou = /you sent|sent by you|you:/.test(joined);
+
+    const rect = bubble.getBoundingClientRect();
+    const center = rect.left + rect.width / 2;
+    const out = saidYou || center > mainRect.left + mainRect.width * 0.6;
+
+    const key = text + '|' + out;
+    if (key === lastKey) continue;
+    lastKey = key;
+    messages.push({text: text.replace(/\s+/g, ' '), out: out});
+  }
+
+  const body = (main.innerText || '').toLowerCase();
+  const empty = messages.length === 0 &&
+    /start a conversation|no messages yet|send your first message/.test(body);
+
+  return {ok: true, title: title.replace(/\s+/g, ' '), messages: messages, empty: empty};
+})()
